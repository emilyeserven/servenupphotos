# syntax=docker/dockerfile:1
# Dev image for the pipeline's Node apps (client-pipeline, bff-pipeline). Build context: repository root.
# Used by docker-compose.dev.yml; each service sets its own dev-server command, and Compose Watch syncs source edits in.
FROM node:22-slim
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true
RUN corepack enable
WORKDIR /repo
COPY . .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter @servenup/bff-pipeline... --filter @servenup/client-pipeline...
