{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "proseWrap": "never",
  "sortImports": {
    "internalPattern": ["@/", "@portfolio/"],
    "newlinesBetween": false
  },
  "ignorePatterns": ["**/routeTree.gen.ts", "pnpm-lock.yaml", "**/testdata/**"],
  "overrides": [
    {
      "files": ["apps/*/src/**/*.md"],
      "options": {
        "proseWrap": "preserve"
      }
    }
  ]
}
