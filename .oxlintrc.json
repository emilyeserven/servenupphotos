{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn", "oxc"],
  "jsPlugins": ["./scripts/lint/servenup-plugin.mjs"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ],
    "servenup/error-note": "warn"
  },
  "ignorePatterns": ["**/dist/**", "**/routeTree.gen.ts"],
  "jsPlugins": ["./scripts/oxlint/request-helpers.mjs"],
  "overrides": [
    {
      "files": ["apps/client-pipeline/src/**/*.{ts,tsx}"],
      "rules": {
        "request-helpers/no-hand-built-json-request": "error"
      }
    },
    {
      "files": ["apps/client-pipeline/src/api/request.ts"],
      "rules": {
        "request-helpers/no-hand-built-json-request": "off"
      }
    }
  ]
}
