# Copy to .env (git-ignored). Used by `docker compose` and local dev.

# Host port the pipeline UI/BFF is published on.
PIPELINE_PORT=8080

# Host port for the pipeline UI in the hot-reload dev stack (docker-compose.dev.yml).
PIPELINE_DEV_PORT=5174

