# Copy to .env (git-ignored). Used by `docker compose` and local dev.

# Host port the pipeline UI/BFF is published on. Change it when another app on the machine uses 8080
# (under Coolify, set it in the resource's Environment Variables instead).
PIPELINE_PORT=8080

# Host port for the pipeline UI in the hot-reload dev stack (docker-compose.dev.yml).
PIPELINE_DEV_PORT=5174

# --- Future: Cloudflare R2 image uploads (not used yet) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# --- Trip lines: transit look-ups ---
# Transitland (https://www.transit.land) API key, for looking up lines and routes there instead of on
# OpenStreetMap's busy Overpass servers (pick Transitland in the menu beside Find lines). Free.
# TRANSITLAND_API_KEY=
