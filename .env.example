# Copy to .env (git-ignored). Used by `docker compose` and local dev.

# Host port the pipeline UI/BFF is published on. Change it when another app on the machine uses 8080
# (under Coolify, set it in the resource's Environment Variables instead).
PIPELINE_PORT=8080

# Host port for the pipeline UI in the hot-reload dev stack (docker-compose.dev.yml).
PIPELINE_DEV_PORT=5174

# --- Future: Cloudflare R2 image uploads (not used yet) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# --- Trip lines: basemap ---
# CARTO (https://carto.com/basemaps) API key for the map tiles under the Trip Lines page's day cards; without one
# they're drawn with no map under them. Free for non-commercial use. The portfolio's deploy reads the same name.
# CARTO_KEY=

# --- Trip lines: transit look-ups ---
# Transitland (https://www.transit.land) API key, for looking up lines and routes there instead of on
# OpenStreetMap's busy Overpass servers (pick Transitland in the menu beside Find lines). Free.
# TRANSITLAND_API_KEY=
# Japan's rail map (pick "Japan rail map" in the same menu) downloads MLIT's railway data once, the first
# time it's asked, into mlit-n02-24 beside the settings file (/data in Docker). MLIT_RAIL_DIR keeps it elsewhere; MLIT_RAIL_URL downloads
# another copy of N02-24_GML.zip.
# MLIT_RAIL_DIR=
# MLIT_RAIL_URL=
# Other countries' rail maps ("Rail map (OpenStreetMap)") download Geofabrik's index of OpenStreetMap extracts and
# then each country's extract once, into osm-rail beside the settings file; OSM_RAIL_DIR keeps them elsewhere and
# GEOFABRIK_INDEX_URL reads another index.
# OSM_RAIL_DIR=
# GEOFABRIK_INDEX_URL=
